# ── LLM（任选其一；推荐 DeepSeek）──
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 也可用 Anthropic / OpenAI（优先级：Anthropic > OpenAI > DeepSeek）
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── 鉴权（JWT 签名密钥，请替换为随机值）──
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_DAYS=7

# ── 讯飞开放平台（STT 语音听写 + TTS 超拟人语音合成共用）──
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=

# ── 面试官 TTS 默认音色/语速 ──
